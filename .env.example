# Змінні середовища для Docker Compose
# Скопіюйте цей файл у .env та заповніть власними значеннями:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=med_user
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=med_queue_db
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
# URL для запитів з браузера клієнта (публічний)
NEXT_PUBLIC_API_URL=http://localhost:8000
# ID лікаря, чий розклад і черга відображаються на дашборді (демо = 1)
NEXT_PUBLIC_DOCTOR_ID=1
NEXT_PUBLIC_DOCTOR_NAME=Іваненко Петро Васильович

