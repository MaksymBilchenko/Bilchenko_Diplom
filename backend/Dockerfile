# =============================================================================
# backend/Dockerfile — Оптимізований образ для FastAPI + Uvicorn
#
# Стратегія:
#   - Базовий образ python:3.12-slim (мінімальний розмір)
#   - Залежності встановлюються окремим шаром (кешування Docker layers)
#   - Uvicorn запускається з --reload для hot-reload у dev-режимі
# =============================================================================

# ---------------------------------------------------------------------------
# Етап 1: базовий образ
# ---------------------------------------------------------------------------
FROM python:3.12-slim

# Мета-дані образу
LABEL maintainer="med-queue-team"
LABEL description="FastAPI backend for medical queue management system"

# ---------------------------------------------------------------------------
# Системні змінні середовища
# PYTHONDONTWRITEBYTECODE=1 — не створює .pyc файли (зменшує розмір)
# PYTHONUNBUFFERED=1        — виводить логи одразу (без буфера)
# ---------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # Тека, де буде розміщено код застосунку всередині контейнера
    APP_HOME=/app

# ---------------------------------------------------------------------------
# Встановлення системних залежностей
# asyncpg не потребує gcc / libpq-dev (на відміну від psycopg2).
# curl необхідний для Docker healthcheck всередині образу
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Робоча директорія
# ---------------------------------------------------------------------------
WORKDIR $APP_HOME

# ---------------------------------------------------------------------------
# Встановлення Python-залежностей
#
# ВАЖЛИВО: Копіюємо лише requirements.txt ПЕРЕД кодом застосунку.
# Це дозволяє Docker кешувати шар із залежностями і не перевстановлювати їх
# при кожній зміні коду (якщо requirements.txt не змінювався).
# ---------------------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------------
# Копіювання вихідного коду
# (У dev-режимі цей шар перекривається volume-монтуванням з docker-compose)
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Відкриваємо порт 8000 (документація/конвенція; фактично пробрасується
# через docker-compose)
# ---------------------------------------------------------------------------
EXPOSE 8000

# ---------------------------------------------------------------------------
# Команда запуску
#
# --host 0.0.0.0  — слухати на всіх інтерфейсах (обов'язково в Docker)
# --port 8000     — порт всередині контейнера
# --reload        — автоматичне перезавантаження при зміні файлів (dev only)
# app.main:app    — шлях до об'єкта FastAPI: модуль app/main.py, змінна app
# ---------------------------------------------------------------------------
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
