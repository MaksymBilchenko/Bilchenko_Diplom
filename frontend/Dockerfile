# =============================================================================
# frontend/Dockerfile — Образ для Next.js у режимі розробки
#
# Стратегія:
#   - Багатоетапна збірка (multi-stage) для розділення dev та prod
#   - Базовий образ node:20-alpine (мінімальний розмір, LTS)
#   - node_modules встановлюються всередині образу (не через volume)
#   - hot-reload забезпечується через монтування ./frontend:/app у compose
# =============================================================================

# ---------------------------------------------------------------------------
# Базовий образ: Node.js 20 LTS на Alpine Linux
# ---------------------------------------------------------------------------
FROM node:20-alpine

# Мета-дані
LABEL maintainer="med-queue-team"
LABEL description="Next.js frontend for medical queue management system"

# ---------------------------------------------------------------------------
# Встановлення системних залежностей
# libc6-compat необхідна для деяких native npm-пакетів на Alpine
# ---------------------------------------------------------------------------
RUN apk add --no-cache libc6-compat

# ---------------------------------------------------------------------------
# Робоча директорія
# ---------------------------------------------------------------------------
WORKDIR /app

# ---------------------------------------------------------------------------
# Встановлення залежностей (кешований шар Docker)
#
# Копіюємо лише package.json та package-lock.json (або yarn.lock) ПЕРЕД
# копіюванням решти коду. Це дозволяє Docker кешувати шар node_modules і
# не перевстановлювати пакети при кожній зміні вихідного коду.
# ---------------------------------------------------------------------------
COPY package.json package-lock.json* ./

# npm ci — детерміністична установка строго за package-lock.json
# --legacy-peer-deps — вмикається за потреби при конфліктах залежностей
RUN npm ci

# ---------------------------------------------------------------------------
# Копіювання решти вихідного коду
# (У dev-режимі перекривається volume-монтуванням з docker-compose,
#  але копіювання потрібне для можливості збирати образ без compose)
# ---------------------------------------------------------------------------
COPY . .

# ---------------------------------------------------------------------------
# Відкриваємо порт 3000 (стандартний порт Next.js dev-сервера)
# ---------------------------------------------------------------------------
EXPOSE 3000

# ---------------------------------------------------------------------------
# Команда запуску Next.js у режимі розробки
#
# `next dev` — вмикає:
#   • Fast Refresh (hot-reload при зміні компонентів)
#   • Детальні повідомлення про помилки
#   • Автоматичну перекомпіляцію TypeScript
#
# Змінна HOST=0.0.0.0 обов'язкова для роботи всередині Docker-контейнера
# ---------------------------------------------------------------------------
ENV HOST=0.0.0.0 \
    PORT=3000 \
    NODE_ENV=development

CMD ["npm", "run", "dev"]
